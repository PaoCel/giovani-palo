# Build non di produzione: `npm run build -- --mode staging`.
# Copia in .env.staging (ignorato da git). Valori dalla console Firebase del
# progetto di staging (Impostazioni progetto > App web). La build FALLISCE se
# manca un valore o se uno coincide con quelli di produzione.
VITE_APP_ENV=staging
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Facoltativo (analytics non usato dall'app).
VITE_FIREBASE_MEASUREMENT_ID=
# Chiave pubblica VAPID del progetto di staging.
VITE_WEB_PUSH_PUBLIC_KEY=
# Palo mostrato sulle pagine pubbliche (id del doc stakes/<id>).
VITE_DEFAULT_STAKE_ID=
