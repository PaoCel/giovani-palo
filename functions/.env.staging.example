# Ambiente NON di produzione (staging/demo). Copia in functions/.env.<projectId>
# (es. functions/.env.giovani-palo-staging): il file e' ignorato da git e la
# CLI lo carica da sola al deploy. Valori obbligatori per un progetto diverso
# da quello di produzione: senza, link e email falliscono con un errore esplicito.

# URL pubblico dell'app di questo ambiente (mai un host di produzione).
APP_PUBLIC_URL=https://demo.gugditalia.it

# Destinatari ammessi (indirizzi esatti o @dominio, separati da virgola).
# Tutto il resto viene "simulato": non parte niente (vale anche per i BCC).
# Vuota o assente = non esce nessuna email.
EMAIL_ALLOWLIST=

# Prefisso dell'oggetto, mittente e reply-to (facoltativi).
EMAIL_SUBJECT_PREFIX=[DEMO]
EMAIL_SENDER_ADDRESS=noreply@gugditalia.it
# EMAIL_REPLY_TO_ADDRESS=

# Chiave pubblica VAPID di QUESTO progetto (coppia propria; la privata sta nel
# secret WEB_PUSH_PRIVATE_KEY). Senza, le push admin restano spente.
WEB_PUSH_PUBLIC_KEY=
