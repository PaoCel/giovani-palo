rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymousSignedIn() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function childDocPath(parentUid, childId) {
      return /databases/$(database)/documents/users/$(parentUid)/children/$(childId);
    }

    function activityDocPath(stakeId, activityId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/activities/$(activityId);
    }

    function legacyEventDocPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function formConfigDocPath(stakeId, activityId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/activities/$(activityId)/config/form;
    }

    function registrationDocPath(stakeId, activityId, registrationId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/activities/$(activityId)/registrations/$(registrationId);
    }

    function currentUserExists() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentUser() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isAdminRole(role) {
      return role == 'admin' || role == 'super_admin';
    }

    function isCurrentUserAdmin() {
      return currentUserExists() && isAdminRole(currentUser().role);
    }

    function isStakeAdmin(stakeId) {
      return isCurrentUserAdmin()
        && (
          currentUser().role == 'super_admin'
          || currentUser().stakeId == stakeId
        );
    }

    function isUnitLeaderOfStake(stakeId) {
      return currentUserExists()
        && currentUser().role == 'unit_leader'
        && currentUser().stakeId == stakeId;
    }

    // Confine per unità: il dirigente vede solo documenti della propria unità.
    // Le query client devono filtrare con where('unitId', '==', <propria unità>)
    // perché la rule sia dimostrabile anche in list.
    // Galleria foto/video dell'attività (docs/GALLERIA_ATTIVITA.md): la vede e
    // la riempie solo chi ha un account nel palo, mai una sessione anonima né
    // un utente di un altro palo. Staff = admin e dirigenti di unità del palo,
    // ruoli assegnati da un admin.
    function isStakeMember(stakeId) {
      return isNonAnonymousSignedIn()
        && currentUserExists()
        && (currentUser().stakeId == stakeId || currentUser().role == 'super_admin');
    }

    function isGalleryStaff(stakeId) {
      return isStakeAdmin(stakeId) || isUnitLeaderOfStake(stakeId);
    }

    function galleryDocPath(stakeId, galleryId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/galleries/$(galleryId);
    }

    function galleryMediaDocPath(stakeId, galleryId, mediaId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/galleries/$(galleryId)/media/$(mediaId);
    }

    function galleryMediaLikePath(stakeId, galleryId, mediaId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/galleries/$(galleryId)/media/$(mediaId)/likes/$(request.auth.uid);
    }

    // Finestra scritta dalla callable activityGallery (inizio attività - 2 ore,
    // fine + 7 giorni) o da un admin. Senza finestra la galleria è chiusa.
    function galleryAcceptsUploads(gallery) {
      return gallery.get('uploadsClosed', false) != true
        && gallery.get('uploadsOpenFrom', null) is timestamp
        && gallery.get('uploadsOpenUntil', null) is timestamp
        && request.time >= gallery.uploadsOpenFrom
        && request.time < gallery.uploadsOpenUntil;
    }

    // Percorso e URL di un file devono stare nella cartella Storage del media,
    // nel bucket del progetto (prod, staging, emulatore demo-*): niente file
    // esterni o di un bucket altrui spacciati per foto della galleria.
    function isOwnMediaPath(value, stakeId, galleryId, mediaId) {
      return value == null
        || (value is string
          && value.matches('^protected/stakes/' + stakeId + '/galleries/' + galleryId + '/media/' + mediaId + '/[^/]+$'));
    }

    function isOwnMediaUrl(value, stakeId, galleryId, mediaId) {
      return value == null
        || (value is string
          && value.matches('^(https://firebasestorage[.]googleapis[.]com/v0/b/giovani-palo(-staging)?[.]firebasestorage[.]app|http://(127[.]0[.]0[.]1|localhost):[0-9]+/v0/b/(demo-[a-z0-9-]+|giovani-palo(-staging)?)[.](firebasestorage[.]app|appspot[.]com))/o/protected%2Fstakes%2F' + stakeId + '%2Fgalleries%2F' + galleryId + '%2Fmedia%2F' + mediaId + '%2F[^/?]+[?].*$'));
    }

    function validMemberMediaCreate(stakeId, galleryId, mediaId) {
      let data = request.resource.data;
      let gallery = get(galleryDocPath(stakeId, galleryId)).data;
      return data.keys().hasOnly([
          'activityId', 'caption', 'contentType', 'createdAt', 'duration',
          'filename', 'height', 'likeCount', 'optimizedPath', 'optimizedUrl',
          'order', 'originalPath', 'originalUrl', 'posterPath', 'posterUrl',
          'sizeBytes', 'status', 'storagePath', 'storageUrl', 'thumbnailPath',
          'thumbnailUrl', 'type', 'updatedAt', 'uploadedBy', 'width'
        ])
        && data.uploadedBy == request.auth.uid
        && (data.type == 'image' || data.type == 'video')
        && data.likeCount == 0
        && data.get('caption', '') is string
        && data.get('caption', '').size() <= 500
        && data.createdAt is string
        && data.createdAt.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-9:.]{12}Z$')
        && data.get('order', 0) is int
        && data.get('activityId', null) == gallery.get('activityId', null)
        && galleryAcceptsUploads(gallery)
        && isOwnMediaPath(data.get('storagePath', null), stakeId, galleryId, mediaId)
        && isOwnMediaPath(data.get('optimizedPath', null), stakeId, galleryId, mediaId)
        && isOwnMediaPath(data.get('originalPath', null), stakeId, galleryId, mediaId)
        && isOwnMediaPath(data.get('thumbnailPath', null), stakeId, galleryId, mediaId)
        && isOwnMediaPath(data.get('posterPath', null), stakeId, galleryId, mediaId)
        && isOwnMediaUrl(data.get('storageUrl', null), stakeId, galleryId, mediaId)
        && isOwnMediaUrl(data.get('optimizedUrl', null), stakeId, galleryId, mediaId)
        && isOwnMediaUrl(data.get('originalUrl', null), stakeId, galleryId, mediaId)
        && isOwnMediaUrl(data.get('thumbnailUrl', null), stakeId, galleryId, mediaId)
        && isOwnMediaUrl(data.get('posterUrl', null), stakeId, galleryId, mediaId);
    }

    // Like: il contatore si muove di uno solo insieme al proprio doc like.
    function validLikeCountUpdate(stakeId, galleryId, mediaId) {
      let likePath = galleryMediaLikePath(stakeId, galleryId, mediaId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
        && (
          (request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(likePath) && existsAfter(likePath))
          || (request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(likePath) && !existsAfter(likePath))
        );
    }

    function isUnitLeaderOfUnit(stakeId, unitId) {
      return isUnitLeaderOfStake(stakeId)
        && unitId != ''
        && currentUser().unitId == unitId;
    }

    function isCampManagementActivity(stakeId, activityId) {
      return exists(activityDocPath(stakeId, activityId))
        && get(activityDocPath(stakeId, activityId)).data.activityType == 'camp';
    }

    function campStaffDocPath(stakeId, activityId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/activities/$(activityId)/management/campStaff;
    }

    // Staff scelto da un admin per questo campeggio: uid in
    // `management/campStaff.staffUids` (scritto solo dalla callable
    // campManagementStaff) e iscrizione `user_<uid>` non annullata. Non conta
    // `genderRoleCategory`: lo scrive chiunque nel proprio profilo e nella
    // propria iscrizione.
    function isListedCampStaff(stakeId, activityId) {
      return isNonAnonymousSignedIn()
        && exists(campStaffDocPath(stakeId, activityId))
        && request.auth.uid in get(campStaffDocPath(stakeId, activityId)).data.staffUids
        && exists(registrationDocPath(stakeId, activityId, 'user_' + request.auth.uid))
        && get(registrationDocPath(stakeId, activityId, 'user_' + request.auth.uid)).data.registrationStatus != 'cancelled';
    }

    function isCampStaffOfActivity(stakeId, activityId) {
      return isCampManagementActivity(stakeId, activityId)
        && (
          isStakeAdmin(stakeId)
          || isUnitLeaderOfStake(stakeId)
          || isListedCampStaff(stakeId, activityId)
        );
    }

    // Notte dei Record (docs/NOTTE_DEI_RECORD.md). Gestiscono i record: gli admin
    // del palo, i dirigenti di unità (ruolo assegnato da un admin, non
    // autodichiarabile) e gli uid in `staffUids` di
    // `stakes/{s}/activities/{a}/management/recordNight`, scritto solo dal server
    // su richiesta di un admin. Non conta `genderRoleCategory`: lo scrive chiunque
    // nel proprio profilo. Non tocca le rules del campeggio.
    function recordNightStaffDocPath(stakeId, activityId) {
      return /databases/$(database)/documents/stakes/$(stakeId)/activities/$(activityId)/management/recordNight;
    }

    function isListedRecordNightStaff(stakeId, activityId) {
      return isNonAnonymousSignedIn()
        && exists(recordNightStaffDocPath(stakeId, activityId))
        && request.auth.uid in get(recordNightStaffDocPath(stakeId, activityId)).data.staffUids;
    }

    function isRecordNightStaff(stakeId, activityId) {
      return isStakeAdmin(stakeId)
        || isUnitLeaderOfStake(stakeId)
        || isListedRecordNightStaff(stakeId, activityId);
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validGenderRoleCategory(value) {
      return value in ['', 'giovane_uomo', 'giovane_donna', 'dirigente', 'accompagnatore'];
    }

    function isPublicActivityDoc(data) {
      return data.isPublic == true
        && data.isVisible != false
        && data.status != 'draft';
    }

    function isPublicActivityListDoc(data) {
      return data.isPublic == true && data.isVisible == true;
    }

    function isPublicActivity(stakeId, activityId) {
      return exists(activityDocPath(stakeId, activityId))
        && isPublicActivityDoc(get(activityDocPath(stakeId, activityId)).data);
    }

    function isPublicLegacyEvent(eventId) {
      return exists(legacyEventDocPath(eventId))
        && isPublicActivityDoc(get(legacyEventDocPath(eventId)).data);
    }

    function activityAcceptsRegistrations(stakeId, activityId) {
      return exists(activityDocPath(stakeId, activityId))
        && get(activityDocPath(stakeId, activityId)).data.isPublic == true
        && get(activityDocPath(stakeId, activityId)).data.isVisible != false
        && get(activityDocPath(stakeId, activityId)).data.status == 'registrations_open';
    }

    function formAllowsGuestRegistration(stakeId, activityId) {
      return exists(formConfigDocPath(stakeId, activityId))
        && get(formConfigDocPath(stakeId, activityId)).data.allowGuestRegistration == true;
    }

    function hasOwnRegistration(stakeId, activityId) {
      return isSignedIn()
        && (
          exists(registrationDocPath(stakeId, activityId, 'user_' + request.auth.uid))
          || exists(registrationDocPath(stakeId, activityId, 'guest_' + request.auth.uid))
        );
    }

    function isOwnRegistration(data) {
      return isSignedIn()
        && (
          (data.userId is string && data.userId == request.auth.uid)
          || (data.anonymousUid is string && data.anonymousUid == request.auth.uid)
          || ('parentUid' in data && data.parentUid is string && data.parentUid == request.auth.uid)
        );
    }

    function registrationBelongsToCaller(data) {
      return isSignedIn()
        && (
          (
            data.userId is string
            && data.userId == request.auth.uid
            && (!('anonymousUid' in data) || data.anonymousUid == null)
            && (!('parentUid' in data) || data.parentUid == null)
          )
          || (
            data.anonymousUid is string
            && data.anonymousUid == request.auth.uid
            && (!('userId' in data) || data.userId == null)
            && (!('parentUid' in data) || data.parentUid == null)
          )
          || (
            'parentUid' in data
            && data.parentUid is string
            && data.parentUid == request.auth.uid
            && 'childId' in data
            && data.childId is string
            && (!('userId' in data) || data.userId == null)
            && (!('anonymousUid' in data) || data.anonymousUid == null)
          )
        );
    }

    function expectedRegistrationId(data) {
      return ('parentUid' in data && data.parentUid is string && 'childId' in data && data.childId is string)
        ? 'child_' + data.parentUid + '_' + data.childId
        : data.userId is string
          ? 'user_' + data.userId
          : data.anonymousUid is string
            ? 'guest_' + data.anonymousUid
            : '__invalid__';
    }

    function isExpectedOwnRegistrationId(registrationId) {
      return isSignedIn()
        && (
          registrationId == 'user_' + request.auth.uid
          || registrationId == 'guest_' + request.auth.uid
          // Iscrizione figlio gestita dal genitore autenticato.
          || registrationId.matches('child_' + request.auth.uid + '_.+')
        );
    }

    function validRegistrationStatus(value) {
      return value in [
        'draft',
        'submitted',
        'confirmed',
        'waitlist',
        'active',
        'cancelled',
        'pending_parent_authorization',
        'rejected_by_parent'
      ];
    }

    function validRegistrationPayload(data) {
      return data.keys().hasOnly([
          'userId',
          'anonymousUid',
          'anonymousTokenId',
          'firstName',
          'lastName',
          'fullName',
          'email',
          'phone',
          'birthDate',
          'genderRoleCategory',
          'unitId',
          'unitNameSnapshot',
          'answers',
          'roomPreferenceMatches',
          'participatingDays',
          'accessCode',
          'recoveryCode',
          'recoveryPdfGenerated',
          'parentConsentDocumentName',
          'parentConsentDocumentUrl',
          'parentConsentDocumentPath',
          'parentConsentUploadedAt',
          'consentSignatureUrl',
          'consentSignaturePath',
          'consentSignatureSetAt',
          'parentIdDocumentName',
          'parentIdDocumentUrl',
          'parentIdDocumentPath',
          'parentIdUploadedAt',
          'parentAuthorization',
          'linkedLaterToUserId',
          'parentUid',
          'childId',
          'registrationStatus',
          'submittedByMode',
          'assignedRoomId',
          'assignedRoomName',
          'assignedTempleShiftId',
          'assignedServiceTeamIds',
          'assignedPatrolId',
          'assignedPatrolName',
          'assignedPatrolRole',
          'assignedCommittees',
          'createdAt',
          'updatedAt'
        ])
        && data.firstName is string
        && data.lastName is string
        && data.fullName is string
        && data.email is string
        && data.phone is string
        && data.birthDate is string
        && validGenderRoleCategory(data.genderRoleCategory)
        && data.unitId is string
        && data.unitNameSnapshot is string
        && data.answers is map
        && (!('roomPreferenceMatches' in data)
          || data.roomPreferenceMatches == null
          || data.roomPreferenceMatches is map)
        && (!('participatingDays' in data)
          || data.participatingDays == null
          || data.participatingDays is list)
        && (data.accessCode == null || data.accessCode is string)
        && (data.recoveryCode == null || data.recoveryCode is string)
        && (data.anonymousTokenId == null || data.anonymousTokenId is string)
        && data.recoveryPdfGenerated is bool
        && (data.parentConsentDocumentName == null || data.parentConsentDocumentName is string)
        && (data.parentConsentDocumentUrl == null || data.parentConsentDocumentUrl is string)
        && (data.parentConsentDocumentPath == null || data.parentConsentDocumentPath is string)
        && (data.parentConsentUploadedAt == null || data.parentConsentUploadedAt is string)
        && (data.consentSignatureUrl == null || data.consentSignatureUrl is string)
        && (data.consentSignaturePath == null || data.consentSignaturePath is string)
        && (data.consentSignatureSetAt == null || data.consentSignatureSetAt is string)
        && (data.parentIdDocumentName == null || data.parentIdDocumentName is string)
        && (data.parentIdDocumentUrl == null || data.parentIdDocumentUrl is string)
        && (data.parentIdDocumentPath == null || data.parentIdDocumentPath is string)
        && (data.parentIdUploadedAt == null || data.parentIdUploadedAt is string)
        && (!('parentAuthorization' in data) || data.parentAuthorization == null || data.parentAuthorization is map)
        && (data.linkedLaterToUserId == null || data.linkedLaterToUserId is string)
        && (!('parentUid' in data) || data.parentUid == null || data.parentUid is string)
        && (!('childId' in data) || data.childId == null || data.childId is string)
        && validRegistrationStatus(data.registrationStatus)
        && data.submittedByMode in ['authenticated', 'anonymous', 'parent']
        && (data.assignedRoomId == null || data.assignedRoomId is string)
        // Scritto solo dalla callable roomManagementSave; assente nei documenti
        // precedenti alla pubblicazione delle stanze.
        && (!('assignedRoomName' in data) || data.assignedRoomName == null || data.assignedRoomName is string)
        && (data.assignedTempleShiftId == null || data.assignedTempleShiftId is string)
        && data.assignedServiceTeamIds is list
        && (data.assignedPatrolId == null || data.assignedPatrolId is string)
        && (data.assignedPatrolName == null || data.assignedPatrolName is string)
        && (data.assignedPatrolRole == null || data.assignedPatrolRole in ['leader', 'supervisor', 'member'])
        && (!('assignedCommittees' in data) || data.assignedCommittees is list)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validRegistrationCreate(stakeId, activityId, registrationId) {
      return validRegistrationPayload(request.resource.data)
        && registrationBelongsToCaller(request.resource.data)
        && expectedRegistrationId(request.resource.data) == registrationId
        && activityAcceptsRegistrations(stakeId, activityId)
        && (
          request.resource.data.userId == request.auth.uid
          || (
            request.resource.data.anonymousUid == request.auth.uid
            && formAllowsGuestRegistration(stakeId, activityId)
          )
          || (
            request.resource.data.parentUid == request.auth.uid
            && exists(childDocPath(request.auth.uid, request.resource.data.childId))
          )
        )
        && request.resource.data.submittedByMode
          == (
            request.resource.data.userId == request.auth.uid
              ? 'authenticated'
              : (
                ('parentUid' in request.resource.data && request.resource.data.parentUid == request.auth.uid)
                  ? 'parent'
                  : 'anonymous'
              )
          )
        && request.resource.data.parentConsentDocumentName == null
        && request.resource.data.parentConsentDocumentUrl == null
        && request.resource.data.parentConsentDocumentPath == null
        && request.resource.data.parentConsentUploadedAt == null
        && request.resource.data.consentSignatureUrl == null
        && request.resource.data.consentSignaturePath == null
        && request.resource.data.consentSignatureSetAt == null
        && request.resource.data.parentIdDocumentName == null
        && request.resource.data.parentIdDocumentUrl == null
        && request.resource.data.parentIdDocumentPath == null
        && request.resource.data.parentIdUploadedAt == null
        && (!('parentAuthorization' in request.resource.data) || request.resource.data.parentAuthorization == null)
        && request.resource.data.assignedRoomId == null
        && request.resource.data.get('assignedRoomName', null) == null
        && request.resource.data.assignedTempleShiftId == null
        && request.resource.data.assignedServiceTeamIds.size() == 0
        && request.resource.data.assignedPatrolId == null
        && request.resource.data.assignedPatrolName == null
        && request.resource.data.assignedPatrolRole == null
        && (!('assignedCommittees' in request.resource.data)
          || request.resource.data.assignedCommittees.size() == 0)
        && request.resource.data.linkedLaterToUserId == null;
    }

    function manualConsentFieldsUnchanged(next, prev) {
      return next.get('parentConsentDocumentName', null) == prev.get('parentConsentDocumentName', null)
        && next.get('parentConsentDocumentUrl', null) == prev.get('parentConsentDocumentUrl', null)
        && next.get('parentConsentDocumentPath', null) == prev.get('parentConsentDocumentPath', null)
        && next.get('parentConsentUploadedAt', null) == prev.get('parentConsentUploadedAt', null)
        && next.get('consentSignatureUrl', null) == prev.get('consentSignatureUrl', null)
        && next.get('consentSignaturePath', null) == prev.get('consentSignaturePath', null)
        && next.get('consentSignatureSetAt', null) == prev.get('consentSignatureSetAt', null)
        && next.get('parentIdDocumentName', null) == prev.get('parentIdDocumentName', null)
        && next.get('parentIdDocumentUrl', null) == prev.get('parentIdDocumentUrl', null)
        && next.get('parentIdDocumentPath', null) == prev.get('parentIdDocumentPath', null)
        && next.get('parentIdUploadedAt', null) == prev.get('parentIdUploadedAt', null);
    }

    // Campi assegnati da staff e server e proprietà: il titolare li rimanda
    // invariati. Assente e null si equivalgono dove i documenti legacy non
    // hanno il campo.
    function registrationAssignedFieldsUnchanged(next, prev) {
      return next.assignedPatrolId == prev.get('assignedPatrolId', null)
        && next.assignedPatrolName == prev.get('assignedPatrolName', null)
        && next.assignedPatrolRole == prev.get('assignedPatrolRole', null)
        && next.get('assignedRoomName', null) == prev.get('assignedRoomName', null)
        && (
          (
            !('assignedCommittees' in prev)
            && (
              !('assignedCommittees' in next)
              || next.assignedCommittees.size() == 0
            )
          )
          || (
            'assignedCommittees' in prev
            && next.assignedCommittees == prev.assignedCommittees
          )
        )
        && next.get('parentUid', null) == prev.get('parentUid', null)
        && next.get('childId', null) == prev.get('childId', null);
    }

    // Codici di accesso e recupero: si impostano una volta, poi restano.
    function registrationAccessFieldsUnchanged(next, prev) {
      return (
          next.anonymousTokenId == prev.anonymousTokenId
          || (
            prev.anonymousTokenId == null
            && (
              next.anonymousTokenId == null
              || next.anonymousTokenId is string
            )
          )
        )
        && (
          next.recoveryCode == prev.recoveryCode
          || (
            prev.recoveryCode == null
            && (
              next.recoveryCode == null
              || next.recoveryCode is string
            )
          )
        )
        && (
          next.accessCode == prev.accessCode
          || (
            prev.accessCode == null
            && (
              next.accessCode == null
              || next.accessCode is string
            )
          )
        )
        && (
          next.recoveryPdfGenerated == prev.recoveryPdfGenerated
          || (
            prev.recoveryPdfGenerated == false
            && next.recoveryPdfGenerated == true
          )
        );
    }

    // Budget: Firestore valuta al massimo 1000 espressioni per richiesta. I
    // controlli di ownership (pochi) vengono prima del payload (molti), così
    // chi non è proprietario esce subito e il ramo staff campo non paga questo
    // costo.
    // Annullamento del titolare (partecipante, ospite o genitore di un figlio):
    // solo lo stato a 'cancelled' e updatedAt. È già concesso da
    // validRegistrationUpdate, ma lì l'iscrizione di un figlio superava il
    // limite di 1000 espressioni (emulatore, 2026-10-19): questo ramo costa
    // poche espressioni e va valutato per primo.
    // Il confronto sullo stato va per primo: ogni altro update del titolare
    // (salvataggio del modulo, riattivazione) esce subito, senza pagare il
    // diff.
    function validOwnerCancellation() {
      return request.resource.data.registrationStatus == 'cancelled'
        && isOwnRegistration(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationStatus', 'updatedAt'])
        && request.resource.data.updatedAt is string;
    }

    // Costo: ogni accesso `request.resource.data.x` vale più espressioni; i
    // confronti dei campi protetti ne costavano circa 250 e un'iscrizione
    // figlio pesante (58 risposte, firma, stanza, pattuglia, comitati) sforava
    // al risalvataggio e alla riattivazione (emulatore, 2026-10-19). Ora i dati
    // passano da `let` e ogni gruppo di confronti ha una scorciatoia: se
    // nessuna sua chiave è in affectedKeys() i valori sono uguali, o assenti in
    // entrambi (i campi letti senza `in` li rende obbligatori
    // validRegistrationPayload), e il confronto dettagliato è vero per
    // costruzione; altrimenti si valuta quello, identico a prima.
    // registrationBelongsToCaller(next), con userId e anonymousUid invariati e
    // parentUid uguale, implica isOwnRegistration(prev): non si ripete.
    // Test: functions/tests/parentCancelRulesEmulator.test.mjs e
    // functions/tests/registrationUpdateRules.py.
    function validRegistrationUpdate() {
      let next = request.resource.data;
      let prev = resource.data;
      let delta = next.diff(prev);
      let changed = delta.affectedKeys();
      return registrationBelongsToCaller(next)
        && validRegistrationPayload(next)
        && delta.unchangedKeys().hasAll([
          'userId', 'anonymousUid', 'createdAt', 'submittedByMode', 'unitId',
          'assignedRoomId', 'assignedTempleShiftId', 'assignedServiceTeamIds',
          'linkedLaterToUserId'
        ])
        && !changed.hasAny(['parentAuthorization'])
        && (
          !changed.hasAny([
            'assignedPatrolId', 'assignedPatrolName', 'assignedPatrolRole',
            'assignedRoomName', 'assignedCommittees', 'parentUid', 'childId'
          ])
          || registrationAssignedFieldsUnchanged(next, prev)
        )
        // Gruppo a parte: un client vecchio che risalva l'intero documento
        // aggiunge assignedCommittees: [] alle iscrizioni legacy, e non deve
        // pagare anche gli 11 confronti dei consensi.
        && (
          !changed.hasAny([
            'parentConsentDocumentName', 'parentConsentDocumentUrl',
            'parentConsentDocumentPath', 'parentConsentUploadedAt',
            'consentSignatureUrl', 'consentSignaturePath', 'consentSignatureSetAt',
            'parentIdDocumentName', 'parentIdDocumentUrl', 'parentIdDocumentPath',
            'parentIdUploadedAt'
          ])
          || manualConsentFieldsUnchanged(next, prev)
        )
        && (
          !changed.hasAny(['anonymousTokenId', 'recoveryCode', 'accessCode', 'recoveryPdfGenerated'])
          || registrationAccessFieldsUnchanged(next, prev)
        )
        && (
          next.registrationStatus == prev.registrationStatus
          || next.registrationStatus == 'cancelled'
          // Riattivazione: chi ha annullato può reiscriversi risalvando il
          // modulo. Senza questo ramo il salvataggio passava ma lo stato
          // restava 'cancelled' e l'iscrizione era invisibile agli admin.
          // 'confirmed' resta escluso: lo scrive solo il genitore che firma.
          || (
            prev.registrationStatus == 'cancelled'
            && next.registrationStatus in ['active', 'pending_parent_authorization']
          )
        );
    }

    function validCampAssignmentUpdate(stakeId, activityId) {
      return isCampStaffOfActivity(stakeId, activityId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedPatrolId',
          'assignedPatrolName',
          'assignedPatrolRole',
          'assignedCommittees',
          'updatedAt'
        ])
        && (request.resource.data.assignedPatrolId == null || request.resource.data.assignedPatrolId is string)
        && (request.resource.data.assignedPatrolName == null || request.resource.data.assignedPatrolName is string)
        && (request.resource.data.assignedPatrolRole == null || request.resource.data.assignedPatrolRole in ['leader', 'supervisor', 'member'])
        && (!('assignedCommittees' in request.resource.data) || request.resource.data.assignedCommittees is list)
        && request.resource.data.updatedAt is string;
    }

    function validQuestionStatus(value) {
      return value in ['active', 'hidden'];
    }

    function validQuestionPayload(data) {
      return data.keys().hasOnly([
          'eventId',
          'stakeId',
          'registrationId',
          'authorUserId',
          'authorAnonymousUid',
          'authorName',
          'text',
          'isAnonymous',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.eventId is string
        && data.stakeId is string
        && data.registrationId is string
        && (data.authorUserId == null || data.authorUserId is string)
        && (data.authorAnonymousUid == null || data.authorAnonymousUid is string)
        && (data.authorName == null || data.authorName is string)
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.isAnonymous is bool
        && validQuestionStatus(data.status)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function questionBelongsToCaller(data) {
      return isSignedIn()
        && (
          (data.authorUserId is string && data.authorUserId == request.auth.uid)
          || (data.authorAnonymousUid is string && data.authorAnonymousUid == request.auth.uid)
        );
    }

    function validQuestionCreate(stakeId, activityId, registrationId) {
      return validQuestionPayload(request.resource.data)
        && questionBelongsToCaller(request.resource.data)
        && request.resource.data.stakeId == stakeId
        && request.resource.data.eventId == activityId
        && request.resource.data.registrationId == registrationId
        && request.resource.data.status == 'active'
        && isExpectedOwnRegistrationId(registrationId)
        && exists(registrationDocPath(stakeId, activityId, registrationId));
    }

    function validQuestionOwnerUpdate() {
      return validQuestionPayload(request.resource.data)
        && questionBelongsToCaller(resource.data)
        && questionBelongsToCaller(request.resource.data)
        && request.resource.data.stakeId == resource.data.stakeId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.registrationId == resource.data.registrationId
        && request.resource.data.authorUserId == resource.data.authorUserId
        && request.resource.data.authorAnonymousUid == resource.data.authorAnonymousUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function canDeleteMigratedGuestRegistration(stakeId, activityId, registrationId) {
      return isSignedIn()
        && registrationId == 'guest_' + request.auth.uid
        && resource.data.anonymousUid == request.auth.uid
        && exists(registrationDocPath(stakeId, activityId, 'user_' + request.auth.uid));
    }

    function validRegistrationAttemptStatus(value) {
      return value in ['started', 'succeeded', 'failed'];
    }

    function validRegistrationAttemptStep(value) {
      return value in [
        'submit_started',
        'registration_saved',
        'recovery_saved',
        'completed',
        'pdf_generated',
        'submit_failed',
        'pdf_failed'
      ];
    }

    function registrationAttemptBelongsToCaller(data) {
      return isSignedIn()
        && (
          (
            data.userId is string
            && data.userId == request.auth.uid
            && (!('anonymousUid' in data) || data.anonymousUid == null)
          )
          || (
            data.anonymousUid is string
            && data.anonymousUid == request.auth.uid
            && (!('userId' in data) || data.userId == null)
          )
        );
    }

    function validRegistrationAttemptPayload(data) {
      return data.keys().hasOnly([
          'stakeId',
          'eventId',
          'eventTitle',
          'registrationId',
          'userId',
          'anonymousUid',
          'submittedByMode',
          'fullName',
          'email',
          'phone',
          'status',
          'lastStep',
          'route',
          'displayMode',
          'online',
          'userAgent',
          'registrationStatus',
          'errorCode',
          'errorMessage',
          'startedAt',
          'completedAt',
          'failedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.stakeId is string
        && data.eventId is string
        && data.eventTitle is string
        && (data.registrationId == null || data.registrationId is string)
        && (data.userId == null || data.userId is string)
        && (data.anonymousUid == null || data.anonymousUid is string)
        && data.submittedByMode in ['authenticated', 'anonymous']
        && data.fullName is string
        && data.email is string
        && data.phone is string
        && validRegistrationAttemptStatus(data.status)
        && validRegistrationAttemptStep(data.lastStep)
        && data.route is string
        && data.displayMode in ['browser', 'standalone', 'unknown']
        && data.online is bool
        && data.userAgent is string
        && (data.registrationStatus == null || validRegistrationStatus(data.registrationStatus))
        && (data.errorCode == null || data.errorCode is string)
        && (data.errorMessage == null || data.errorMessage is string)
        && data.startedAt is string
        && (data.completedAt == null || data.completedAt is string)
        && (data.failedAt == null || data.failedAt is string)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validRegistrationAttemptCreate(stakeId) {
      return validRegistrationAttemptPayload(request.resource.data)
        && request.resource.data.stakeId == stakeId
        && registrationAttemptBelongsToCaller(request.resource.data)
        && request.resource.data.status == 'started'
        && request.resource.data.lastStep == 'submit_started'
        && request.resource.data.registrationId == null
        && request.resource.data.registrationStatus == null
        && request.resource.data.completedAt == null
        && request.resource.data.failedAt == null
        && request.resource.data.errorCode == null
        && request.resource.data.errorMessage == null
        && request.resource.data.createdAt == request.resource.data.startedAt;
    }

    function validRegistrationAttemptUpdate(stakeId) {
      return validRegistrationAttemptPayload(request.resource.data)
        && request.resource.data.stakeId == stakeId
        && registrationAttemptBelongsToCaller(resource.data)
        && registrationAttemptBelongsToCaller(request.resource.data)
        && request.resource.data.stakeId == resource.data.stakeId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.eventTitle == resource.data.eventTitle
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.anonymousUid == resource.data.anonymousUid
        && request.resource.data.submittedByMode == resource.data.submittedByMode
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.route == resource.data.route
        && request.resource.data.displayMode == resource.data.displayMode
        && request.resource.data.userAgent == resource.data.userAgent
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.startedAt == resource.data.startedAt;
    }

    function validAnonymousTokenPayload(data) {
      return data.keys().hasOnly([
          'registrationId',
          'activityId',
          'stakeId',
          'anonymousUid',
          'recoveryCode',
          'pdfDataSummary',
          'createdAt',
          'expiresAt'
        ])
        && data.registrationId is string
        && data.activityId is string
        && data.stakeId is string
        && data.anonymousUid is string
        && data.recoveryCode is string
        && data.pdfDataSummary is map
        && data.createdAt is string
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is string);
    }

    function validAlertSeverity(value) {
      return value in ['info', 'warning', 'critical', 'success'];
    }

    function validAdminAlertPayload(data) {
      return data.keys().hasOnly([
          'type',
          'stakeId',
          'eventId',
          'registrationId',
          'eventTitle',
          'participantName',
          'submittedByMode',
          'title',
          'message',
          'severity',
          'active',
          'readBy',
          'createdAt',
          'updatedAt'
        ])
        && data.type in ['registration_created']
        && data.stakeId is string
        && data.eventId is string
        && (data.registrationId == null || data.registrationId is string)
        && data.eventTitle is string
        && data.participantName is string
        && data.submittedByMode in ['authenticated', 'anonymous', 'parent']
        && data.title is string
        && data.message is string
        && validAlertSeverity(data.severity)
        && data.active is bool
        && data.readBy is list
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validAdminAlertUpdate(stakeId) {
      return isStakeAdmin(stakeId)
        && validAdminAlertPayload(request.resource.data)
        && request.resource.data.type == resource.data.type
        && request.resource.data.stakeId == resource.data.stakeId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.registrationId == resource.data.registrationId
        && request.resource.data.eventTitle == resource.data.eventTitle
        && request.resource.data.participantName == resource.data.participantName
        && request.resource.data.submittedByMode == resource.data.submittedByMode
        && request.resource.data.title == resource.data.title
        && request.resource.data.message == resource.data.message
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validPushPermission(value) {
      return value in ['default', 'denied', 'granted', 'unsupported'];
    }

    function validAdminPushSubscriptionKeys(data) {
      return data.keys().hasOnly([
          'auth',
          'p256dh'
        ])
        && data.auth is string
        && data.p256dh is string;
    }

    function validAdminPushSubscription(data) {
      return data.keys().hasOnly([
          'endpoint',
          'expirationTime',
          'keys'
        ])
        && data.endpoint is string
        && (data.expirationTime == null || data.expirationTime is number)
        && data.keys is map
        && validAdminPushSubscriptionKeys(data.keys);
    }

    function validAdminPushDevicePayload(stakeId, data) {
      return data.keys().hasOnly([
          'id',
          'stakeId',
          'userId',
          'userName',
          'role',
          'permission',
          'subscription',
          'userAgent',
          'platform',
          'isStandalone',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'lastDeliveredAt',
          'lastError'
        ])
        && data.id is string
        && data.stakeId == stakeId
        && data.userId is string
        && data.userName is string
        && data.role in ['admin', 'super_admin']
        && validPushPermission(data.permission)
        && (data.subscription == null
          || (data.subscription is map && validAdminPushSubscription(data.subscription)))
        && data.userAgent is string
        && data.platform is string
        && data.isStandalone is bool
        && data.createdAt is string
        && data.updatedAt is string
        && data.lastSeenAt is string
        && (!('lastDeliveredAt' in data) || data.lastDeliveredAt == null || data.lastDeliveredAt is string)
        && (!('lastError' in data) || data.lastError == null || data.lastError is string);
    }

    function ownsReferencedAnonymousRegistration(data) {
      return isSignedIn()
        && data.anonymousUid == request.auth.uid
        && exists(registrationDocPath(data.stakeId, data.activityId, data.registrationId))
        && get(registrationDocPath(data.stakeId, data.activityId, data.registrationId)).data.anonymousUid == request.auth.uid;
    }

    function validUserPayload(data) {
      return data.keys().hasOnly([
          'firstName',
          'lastName',
          'fullName',
          'email',
          'phone',
          'role',
          'city',
          'birthDate',
          'genderRoleCategory',
          'unitId',
          'unitName',
          'stakeId',
          'stakeSlug',
          'stakeName',
          'mustChangePassword',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && data.firstName is string
        && data.lastName is string
        && data.fullName is string
        && (data.email == null || data.email is string)
        && (!('phone' in data) || data.phone == null || data.phone is string)
        && data.role in ['participant', 'admin', 'super_admin', 'unit_leader', 'parent']
        && (!('city' in data) || data.city == null || data.city is string)
        && data.birthDate is string
        && validGenderRoleCategory(data.genderRoleCategory)
        && data.unitId is string
        && data.unitName is string
        && data.stakeId is string
        && data.stakeSlug is string
        && data.stakeName is string
        && data.mustChangePassword is bool
        && data.createdAt is string
        && data.updatedAt is string
        && data.lastLoginAt is string;
    }

    // stakeId assegnabile da chi si scrive il profilo: vuoto (nessun palo
    // ancora scelto) oppure l'id di un palo che esiste. Niente barre: lo
    // stakeId finisce in un path e non deve puntare a un altro documento.
    function isEmptyOrExistingStake(stakeId) {
      return stakeId == ''
        || (
          !stakeId.matches('.*/.*')
          && exists(/databases/$(database)/documents/stakes/$(stakeId))
        );
    }

    function canCreateOwnUser(uid) {
      return isSelf(uid)
        && validUserPayload(request.resource.data)
        && isEmptyOrExistingStake(request.resource.data.stakeId)
        && request.resource.data.role in ['participant', 'parent']
        && request.resource.data.mustChangePassword == false;
    }

    function canUpdateOwnUser(uid) {
      return isSelf(uid)
        && validUserPayload(request.resource.data)
        // participant <-> parent: scambio self-service sicuro (nessun
        // privilegio su dati altrui). Gli altri ruoli restano solo admin.
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role in ['participant', 'parent']
            && request.resource.data.role in ['participant', 'parent']
          )
        )
        && (
          !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && (
          request.resource.data.mustChangePassword == resource.data.mustChangePassword
          || (
            resource.data.mustChangePassword == true
            && request.resource.data.mustChangePassword == false
          )
        )
        // stakeId decide i poteri di admin e dirigente (isStakeAdmin,
        // isUnitLeaderOfStake): per i ruoli privilegiati, anche con stakeId
        // vuoto, non lo cambia nessun self-update (solo i tool/Admin SDK).
        // participant e parent possono cambiare palo, ma verso uno esistente.
        && (
          request.resource.data.stakeId == resource.data.stakeId
          || (
            resource.data.role in ['participant', 'parent']
            && isEmptyOrExistingStake(request.resource.data.stakeId)
          )
        )
        // I ruoli privilegiati non possono spostarsi di unità da soli:
        // unitId determina il confine di lettura dei dirigenti di unità
        // (isUnitLeaderOfUnit), quindi lo cambia solo un admin.
        && (
          resource.data.role in ['participant', 'parent']
          || (
            request.resource.data.unitId == resource.data.get('unitId', '')
            && request.resource.data.unitName == resource.data.get('unitName', '')
          )
        );
    }

    function canAdminAssignUserRole() {
      return currentUserExists()
        && validUserPayload(request.resource.data)
        && isStakeAdmin(resource.data.stakeId)
        && resource.data.role != 'super_admin'
        && request.resource.data.stakeId == resource.data.stakeId
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.firstName == resource.data.firstName
        && request.resource.data.lastName == resource.data.lastName
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('city', '') == resource.data.get('city', '')
        && request.resource.data.birthDate == resource.data.birthDate
        && request.resource.data.genderRoleCategory == resource.data.genderRoleCategory
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.unitName == resource.data.unitName
        && request.resource.data.stakeSlug == resource.data.stakeSlug
        && request.resource.data.stakeName == resource.data.stakeName
        && request.resource.data.mustChangePassword == resource.data.mustChangePassword
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLoginAt == resource.data.lastLoginAt
        && request.resource.data.updatedAt is string
        && request.resource.data.role in ['participant', 'admin', 'unit_leader', 'parent'];
    }

    function validChildPayload(data) {
      return data.keys().hasOnly([
          'firstName',
          'lastName',
          'fullName',
          'birthDate',
          'genderRoleCategory',
          'unitId',
          'unitName',
          'stakeId',
          'createdAt',
          'updatedAt'
        ])
        && data.firstName is string
        && data.firstName.size() > 0
        && data.lastName is string
        && data.fullName is string
        && data.birthDate is string
        && validGenderRoleCategory(data.genderRoleCategory)
        && data.unitId is string
        && data.unitName is string
        && data.stakeId is string
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /users/{uid} {
      allow get: if isSelf(uid)
        || isStakeAdmin(resource.data.stakeId)
        || isUnitLeaderOfUnit(resource.data.stakeId, resource.data.unitId);
      allow list: if isStakeAdmin(resource.data.stakeId)
        || isUnitLeaderOfUnit(resource.data.stakeId, resource.data.unitId);
      allow create: if canCreateOwnUser(uid);
      allow update: if canUpdateOwnUser(uid) || canAdminAssignUserRole();
      allow delete: if false;

      // Specchio delle gallerie sbloccate dall'utente. La scrittura avviene
      // solo via Cloud Function (admin SDK) dopo verifica del codice galleria.
      // Il client deve poterlo leggere per sapere quali gallerie sono già aperte.
      match /unlockedGalleries/{galleryId} {
        allow get, list: if isSelf(uid);
        allow create, update, delete: if false;
      }

      // Profili figli gestiti da un account genitore. Solo il genitore li
      // amministra; gli admin del palo possono consultarli per supporto.
      match /children/{childId} {
        allow get, list: if isSelf(uid) || isStakeAdmin(resource.data.stakeId);
        allow create: if isSelf(uid) && validChildPayload(request.resource.data);
        allow update: if isSelf(uid)
          && validChildPayload(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(uid);
      }
    }

    match /stakes/{stakeId} {
      allow get, list: if true;
      allow create, update, delete: if isStakeAdmin(stakeId);

      // Feed pubblico nell'home dell'app: post pubblicati visibili a chiunque (anche
      // non loggati). Scrittura solo admin (di solito creato da Cloud Functions).
      match /feedPosts/{postId} {
        allow get, list: if (resource == null || resource.data.published == true) || isStakeAdmin(stakeId);
        // Permettiamo update solo per likeCount (incremento) da utenti loggati,
        // resto solo admin.
        allow update: if isStakeAdmin(stakeId)
          || (
            isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
          );
        allow create, delete: if isStakeAdmin(stakeId);

        match /likes/{uid} {
          allow get: if isStakeAdmin(stakeId)
            || (isSignedIn() && request.auth.uid == uid);
          allow list: if isStakeAdmin(stakeId);
          allow create, delete: if isSignedIn() && request.auth.uid == uid;
          allow update: if false;
        }

        match /comments/{commentId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000;
          allow update: if isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if isStakeAdmin(stakeId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);
        }
      }

      // Galleria foto/video dell'attività (docs/GALLERIA_ATTIVITA.md). La
      // vedono e la riempiono solo i membri del palo con un account; la crea un
      // admin o la callable activityGallery (id act_<activityId>), che scrive
      // anche la finestra di caricamento. Le segnalazioni e i contenuti nascosti
      // li scrive solo la callable. Lo staff (admin, dirigenti di unità) toglie
      // qualunque contenuto; ogni membro toglie i propri.
      match /galleries/{galleryId} {
        allow get, list: if isStakeMember(stakeId);
        allow create, delete: if isStakeAdmin(stakeId);
        // Update: admin liberi; gli altri membri solo il contatore, di uno alla
        // volta, nello stesso batch che crea o cancella un proprio media.
        allow update: if isStakeAdmin(stakeId)
          || (
            isStakeMember(stakeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mediaCount', 'updatedAt'])
            && (
              request.resource.data.mediaCount == resource.data.mediaCount + 1
              || request.resource.data.mediaCount == resource.data.mediaCount - 1
            )
          );

        match /media/{mediaId} {
          allow get, list: if isStakeMember(stakeId);
          allow update: if isStakeAdmin(stakeId)
            || (isStakeMember(stakeId) && validLikeCountUpdate(stakeId, galleryId, mediaId));
          // Invariante: uploadedBy è sempre l'uid di chi carica, mai
          // gallery.createdBy (un client che lo copiava ha rotto gli upload).
          allow create: if isStakeAdmin(stakeId)
            || (isStakeMember(stakeId) && validMemberMediaCreate(stakeId, galleryId, mediaId));
          allow delete: if isGalleryStaff(stakeId)
            || (isStakeMember(stakeId) && resource.data.uploadedBy == request.auth.uid);

          // Il doc like nasce e muore solo insieme al +1/-1 del contatore, nello
          // stesso batch: altrimenti "cancella il like, rifai like" gonfia il
          // contatore all'infinito.
          match /likes/{uid} {
            allow get: if isStakeAdmin(stakeId)
              || (isStakeMember(stakeId) && request.auth.uid == uid);
            allow list: if isStakeAdmin(stakeId);
            allow create: if isStakeMember(stakeId) && request.auth.uid == uid
              && getAfter(galleryMediaDocPath(stakeId, galleryId, mediaId)).data.likeCount
                == get(galleryMediaDocPath(stakeId, galleryId, mediaId)).data.likeCount + 1;
            allow delete: if isStakeMember(stakeId) && request.auth.uid == uid
              && getAfter(galleryMediaDocPath(stakeId, galleryId, mediaId)).data.likeCount
                == get(galleryMediaDocPath(stakeId, galleryId, mediaId)).data.likeCount - 1;
            allow update: if false;
          }

          match /comments/{commentId} {
            allow get, list: if isStakeMember(stakeId);
            allow create: if isStakeMember(stakeId)
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.body is string
              && request.resource.data.body.size() > 0
              && request.resource.data.body.size() <= 2000;
            allow update: if isStakeMember(stakeId)
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.createdAt == resource.data.createdAt;
            allow delete: if isGalleryStaff(stakeId)
              || (isStakeMember(stakeId) && resource.data.uid == request.auth.uid);
          }
        }

        // Contenuti nascosti da una segnalazione: li vede lo staff, e chi li ha
        // caricati (query filtrata per uploadedBy). Scrive solo la callable.
        match /hiddenMedia/{mediaId} {
          allow get, list: if isGalleryStaff(stakeId)
            || (isStakeMember(stakeId) && resource.data.uploadedBy == request.auth.uid);
          allow write: if false;
        }

        match /reports/{reportId} {
          allow get, list: if isGalleryStaff(stakeId);
          allow write: if false;
        }

        match /members/{uid} {
          allow get: if isStakeAdmin(stakeId)
            || (isSignedIn() && request.auth.uid == uid);
          allow list: if isStakeAdmin(stakeId);
          allow create, update, delete: if isStakeAdmin(stakeId);
        }
      }

      // Codici segreti gallerie: SOLO Cloud Functions admin SDK. Nessun accesso client.
      match /gallerySecrets/{secretId} {
        allow read, write: if false;
      }

      match /units/{unitId} {
        allow get, list: if isStakeAdmin(stakeId) || resource.data.isActive == true;
        allow create, update, delete: if isStakeAdmin(stakeId);
      }

      match /registrationAttempts/{attemptId} {
        allow get, list: if isStakeAdmin(stakeId);
        allow create: if isStakeAdmin(stakeId) || validRegistrationAttemptCreate(stakeId);
        allow update: if isStakeAdmin(stakeId) || validRegistrationAttemptUpdate(stakeId);
        allow delete: if false;
      }

      match /adminAlerts/{alertId} {
        allow get, list: if isStakeAdmin(stakeId);
        allow create: if isStakeAdmin(stakeId);
        allow update: if validAdminAlertUpdate(stakeId);
        allow delete: if false;
      }

      match /adminPushDevices/{deviceId} {
        allow get, list: if isStakeAdmin(stakeId);
        allow create: if isStakeAdmin(stakeId)
          && validAdminPushDevicePayload(stakeId, request.resource.data)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isStakeAdmin(stakeId)
          && validAdminPushDevicePayload(stakeId, request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isStakeAdmin(stakeId)
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }

      // Piante delle strutture (es. Foresteria): geometria e numeri di stanza, nessun
      // dato personale. Le vedono e le salvano solo gli admin del palo; la forma di
      // piani e stanze la valida il client prima di salvare (limite 1 MiB per documento).
      match /roomLayouts/{layoutId} {
        allow get, list: if isStakeAdmin(stakeId);
        allow create, update: if isStakeAdmin(stakeId)
          && layoutId.matches('^[a-z0-9-]{1,60}$')
          && request.resource.data.keys().hasOnly(['version', 'name', 'floors', 'updatedAt'])
          && request.resource.data.keys().hasAll(['version', 'name', 'floors', 'updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.floors is list
          && request.resource.data.floors.size() > 0
          && request.resource.data.floors.size() <= 6
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow get: if isStakeAdmin(stakeId)
          || isPublicActivityDoc(resource.data)
          || hasOwnRegistration(stakeId, activityId)
          || isUnitLeaderOfStake(stakeId);
        allow list: if isStakeAdmin(stakeId) || isPublicActivityListDoc(resource.data) || isUnitLeaderOfStake(stakeId);
        allow create, update, delete: if isStakeAdmin(stakeId);

        match /config/{configId} {
          allow get: if configId == 'form'
            && (
              isStakeAdmin(stakeId)
              || isPublicActivity(stakeId, activityId)
              || hasOwnRegistration(stakeId, activityId)
            );
          allow list: if false;
          allow create, update, delete: if isStakeAdmin(stakeId);
        }

        match /management/{managementId} {
          // Il piano camere `rooms` contiene solo ID delle iscrizioni: lettura
          // admin del palo, scrittura esclusivamente tramite callable Admin SDK.
          // I permessi di scrittura client qui sotto restano limitati a `camp`.
          allow get, list: if isStakeAdmin(stakeId)
            || (managementId == 'camp' && isCampStaffOfActivity(stakeId, activityId))
            || (
              managementId == 'camp'
              && isNonAnonymousSignedIn()
              && hasOwnRegistration(stakeId, activityId)
            );
          allow create, update: if isCampStaffOfActivity(stakeId, activityId)
            && managementId == 'camp'
            && request.resource.data.keys().hasOnly([
              'committees',
              'patrols',
              'manualLeaders',
              'updatedAt',
              'savedAt'
            ])
            && request.resource.data.committees is list
            && request.resource.data.patrols is list
            && request.resource.data.manualLeaders is list
            && request.resource.data.updatedAt is string;
          allow delete: if isCampStaffOfActivity(stakeId, activityId)
            && managementId == 'camp';
        }

        match /formFields/{fieldId} {
          allow get, list: if isStakeAdmin(stakeId)
            || isPublicActivity(stakeId, activityId)
            || hasOwnRegistration(stakeId, activityId);
          allow create, update, delete: if isStakeAdmin(stakeId);
        }

        match /registrations/{registrationId} {
          allow get: if isStakeAdmin(stakeId)
            || isExpectedOwnRegistrationId(registrationId)
            || isOwnRegistration(resource.data)
            || isUnitLeaderOfUnit(stakeId, resource.data.unitId)
            || isCampStaffOfActivity(stakeId, activityId);
          allow list: if isStakeAdmin(stakeId)
            || isUnitLeaderOfUnit(stakeId, resource.data.unitId)
            || isCampStaffOfActivity(stakeId, activityId);
          allow create: if isStakeAdmin(stakeId)
            || validRegistrationCreate(stakeId, activityId, registrationId);
          // Ordine per costo: il proprietario non deve pagare le letture del
          // ramo staff campo (attività, iscrizione adulta) prima del proprio.
          // validOwnerCancellation per primo: è il più economico (circa 12
          // espressioni contro le 600-800 di validRegistrationUpdate).
          allow update: if validOwnerCancellation() || isStakeAdmin(stakeId) || validRegistrationUpdate() || validCampAssignmentUpdate(stakeId, activityId);
          allow delete: if isStakeAdmin(stakeId)
            || canDeleteMigratedGuestRegistration(stakeId, activityId, registrationId);

          match /questions/{questionId} {
            allow get: if isStakeAdmin(stakeId)
              || isExpectedOwnRegistrationId(registrationId);
            allow list: if isStakeAdmin(stakeId)
              || isExpectedOwnRegistrationId(registrationId);
            allow create: if isStakeAdmin(stakeId)
              || validQuestionCreate(stakeId, activityId, registrationId);
            allow update: if (isStakeAdmin(stakeId)
                && validQuestionPayload(request.resource.data)
                && request.resource.data.stakeId == resource.data.stakeId
                && request.resource.data.eventId == resource.data.eventId
                && request.resource.data.registrationId == resource.data.registrationId
                && request.resource.data.createdAt == resource.data.createdAt)
              || validQuestionOwnerUpdate();
            allow delete: if isStakeAdmin(stakeId)
              || isExpectedOwnRegistrationId(registrationId);
          }
        }

        match /consentAuditLogs/{auditId} {
          allow get, list: if isStakeAdmin(stakeId);
          allow create, update, delete: if false;
        }

        // Compiti "controlla album e social" dopo la revoca di un consenso:
        // li crea solo la callable parentConsentUpdate. L'admin del palo li
        // legge e cambia soltanto lo stato (da fare / fatto, e di nuovo da
        // fare se ha sbagliato tocco).
        match /consentTasks/{taskId} {
          allow get, list: if isStakeAdmin(stakeId);
          allow update: if isStakeAdmin(stakeId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'doneAt', 'doneByUid'])
            && request.resource.data.status in ['todo', 'done']
            && (request.resource.data.status == 'todo'
              ? request.resource.data.doneAt == null && request.resource.data.doneByUid == null
              : request.resource.data.doneAt is string
                && request.resource.data.doneByUid == request.auth.uid);
          allow create, delete: if false;
        }

        match /transportNotes/{noteId} {
          allow get, list: if isStakeAdmin(stakeId) || isUnitLeaderOfStake(stakeId);
          allow create, update: if isUnitLeaderOfStake(stakeId)
            && request.resource.data.keys().hasOnly(['registrationId', 'resolvedByUid', 'resolvedAt'])
            && request.resource.data.registrationId == noteId
            && request.resource.data.resolvedByUid == request.auth.uid
            && request.resource.data.resolvedAt is string;
          allow delete: if isUnitLeaderOfStake(stakeId);
        }

        match /packingChecklists/{userId} {
          allow get: if isStakeAdmin(stakeId)
            || (
              isNonAnonymousSignedIn()
              && request.auth.uid == userId
              && hasOwnRegistration(stakeId, activityId)
            );
          allow list: if false;
          allow create, update: if isNonAnonymousSignedIn()
            && request.auth.uid == userId
            && hasOwnRegistration(stakeId, activityId)
            && request.resource.data.keys().hasOnly([
              'userId',
              'checkedItemIds',
              'updatedAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.checkedItemIds is list
            && request.resource.data.updatedAt is string;
          allow delete: if isNonAnonymousSignedIn()
            && request.auth.uid == userId
            && hasOwnRegistration(stakeId, activityId);
        }

        match /surveyQuestions/{questionId} {
          allow get, list: if isStakeAdmin(stakeId) || isSignedIn();
          allow create, update, delete: if isStakeAdmin(stakeId);
        }

        match /surveyResponses/{responseId} {
          // get aperto ai signed-in: serve a riprendere/aggiornare la propria
          // bozza sondaggio (id casuale memorizzato in localStorage). Le risposte
          // sono anonime (no userId/anonymousUid). list resta solo admin.
          allow get: if isStakeAdmin(stakeId) || isSignedIn();
          allow list: if isStakeAdmin(stakeId);
          allow create: if isSignedIn()
            && request.resource.data.eventId == activityId
            && request.resource.data.stakeId == stakeId
            && validGenderRoleCategory(request.resource.data.category)
            && !('userId' in request.resource.data)
            && !('anonymousUid' in request.resource.data);
          // Update consentito solo finché la risposta è ancora una bozza:
          // una volta inviata (isDraft == false) non è più sovrascrivibile,
          // così nessun altro loggato può distruggere un invio definitivo
          // conoscendone l'id casuale. L'anonimato resta intatto (nessuna
          // identità è tracciata sul documento).
          allow update: if isSignedIn()
            && resource.data.isDraft == true
            && request.resource.data.eventId == activityId
            && request.resource.data.stakeId == stakeId
            && validGenderRoleCategory(request.resource.data.category)
            && !('userId' in request.resource.data)
            && !('anonymousUid' in request.resource.data);
          allow delete: if isStakeAdmin(stakeId);
        }

        // Notte dei Record (docs/NOTTE_DEI_RECORD.md). Record e tentativi li scrive
        // solo la callable (Admin SDK): i client leggono e basta.
        // `records`: testi approvati da un admin ma scritti da minori, quindi mai
        // senza login. I membri del palo (anche chi non è iscritto all'attività)
        // leggono solo i record `open` e devono interrogare con
        // `where('status', '==', 'open')`; lo staff (admin, dirigenti di unità,
        // uid in elenco) legge tutto. Il client mostra poi solo quelli con
        // `challengerCount > 0` o `featured` ("idea dello staff"); i nomi non
        // stanno qui.
        match /records/{recordId} {
          allow get, list: if (
              isNonAnonymousSignedIn()
              && resource.data.status == 'open'
              && currentUserExists()
              && currentUser().stakeId == stakeId
            )
            || isRecordNightStaff(stakeId, activityId);
          allow create, update, delete: if false;
        }

        // `recordEntries`: i tentativi portano i nomi dei ragazzi. Li legge il
        // titolare (query `where ownerUid == uid`: un genitore vede quelli dei
        // figli) e lo staff.
        match /recordEntries/{entryId} {
          allow get, list: if (
              isNonAnonymousSignedIn()
              && resource.data.ownerUid == request.auth.uid
            )
            || isRecordNightStaff(stakeId, activityId);
          allow create, update, delete: if false;
        }

        // `recordRequests`: richieste di chi non ha un account
        // (docs/NOTTE_DEI_RECORD_SENZA_ACCOUNT.md). Portano nome, cognome e unità
        // digitati da un minore: non le legge e non le scrive nessun client, nemmeno
        // lo staff. Tutto passa dalle callable `recordNightGuest` e
        // `recordNightAdmin` (Admin SDK), che calcolano anche i suggerimenti.
        match /recordRequests/{requestId} {
          allow read, write: if false;
        }
      }
    }

    // Query collection-group sulle registrazioni: servono al collegamento
    // guest -> account (where anonymousUid == uid). Le rules sui singoli
    // path non coprono le query cross-collection, quindi serve questo match.
    // Richiede l'indice collection-group su anonymousUid (firestore.indexes.json).
    match /{path=**}/registrations/{registrationId} {
      allow list: if isSignedIn()
        && (
          resource.data.anonymousUid == request.auth.uid
          || resource.data.parentUid == request.auth.uid
        );
    }

    // Domande di tutte le iscrizioni di un evento in una sola query
    // (where stakeId == && eventId ==): solo admin del palo.
    match /{path=**}/questions/{questionId} {
      allow list: if isStakeAdmin(resource.data.stakeId);
    }

    match /anonymousRegistrationTokens/{tokenId} {
      allow get: if isSignedIn()
        && (
          resource.data.anonymousUid == request.auth.uid
          || isStakeAdmin(resource.data.stakeId)
        );
      allow list: if false;
      allow create: if validAnonymousTokenPayload(request.resource.data)
        && ownsReferencedAnonymousRegistration(request.resource.data);
      allow update: if validAnonymousTokenPayload(request.resource.data)
        && ownsReferencedAnonymousRegistration(request.resource.data)
        && request.resource.data.registrationId == resource.data.registrationId
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.stakeId == resource.data.stakeId
        && request.resource.data.anonymousUid == resource.data.anonymousUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Token magic-link autorizzazione genitoriale.
    // Tutti gli accessi (lookup tramite hash, creazione, invalidazione)
    // passano da Cloud Functions con Admin SDK che bypassa queste rules.
    // Da client: nessun accesso, nemmeno per admin (i dati sensibili non
    // devono mai essere letti dal browser).
    match /parentAuthorizationTokens/{tokenId} {
      allow get, list, create, update, delete: if false;
    }

    // Cache firme genitore (riuso firma tra attività): scrittura e lettura
    // solo via Cloud Functions con Admin SDK. Nessun accesso client.
    match /parentAuthorizationSignatureCache/{cacheId} {
      allow get, list, create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow get: if settingId == 'organization';
      allow list: if false;
      allow create, update, delete: if isStakeAdmin('roma-est') && settingId == 'organization';
    }

    match /events/{eventId} {
      allow get: if isStakeAdmin('roma-est') || isPublicActivityDoc(resource.data);
      allow list: if isStakeAdmin('roma-est') || isPublicActivityDoc(resource.data);
      allow create, update, delete: if isStakeAdmin('roma-est');

      match /config/{configId} {
        allow get: if configId == 'form'
          && (
            isStakeAdmin('roma-est')
            || isPublicLegacyEvent(eventId)
          );
        allow list: if false;
        allow create, update, delete: if isStakeAdmin('roma-est');
      }
    }
  }
}
