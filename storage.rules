rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function userDocPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function registrationDocPath(stakeId, activityId, registrationId) {
      return /databases/(default)/documents/stakes/$(stakeId)/activities/$(activityId)/registrations/$(registrationId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return isSignedIn() && firestore.exists(userDocPath(request.auth.uid));
    }

    function currentUser() {
      return firestore.get(userDocPath(request.auth.uid)).data;
    }

    function isAdminRole(role) {
      return role == 'admin' || role == 'super_admin';
    }

    function isStakeAdmin(stakeId) {
      return currentUserExists()
        && isAdminRole(currentUser().role)
        && (
          currentUser().role == 'super_admin'
          || currentUser().stakeId == stakeId
        );
    }

    function isRegistrationOwner(stakeId, activityId, registrationId) {
      return isSignedIn()
        && firestore.exists(registrationDocPath(stakeId, activityId, registrationId))
        && (
          firestore.get(registrationDocPath(stakeId, activityId, registrationId)).data.userId == request.auth.uid
          || firestore.get(registrationDocPath(stakeId, activityId, registrationId)).data.anonymousUid == request.auth.uid
          // Iscrizioni create da un account genitore per un figlio collegato.
          || firestore.get(registrationDocPath(stakeId, activityId, registrationId)).data.get('parentUid', '') == request.auth.uid
        );
    }

    match /public/stakes/{stakeId}/activities/{activityId}/{fileName=**} {
      allow read: if true;
      allow write: if isStakeAdmin(stakeId);
    }

    match /public/stakes/{stakeId}/settings/{assetKind}/{fileName=**} {
      allow read: if true;
      allow write: if isStakeAdmin(stakeId);
    }

    match /public/stakes/{stakeId}/drafts/{uid}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId);
      allow write: if isStakeAdmin(stakeId);
    }

    match /protected/stakes/{stakeId}/activities/{activityId}/parent-consents/{registrationId}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
      allow write: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
    }

    match /protected/stakes/{stakeId}/activities/{activityId}/signatures/{registrationId}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
      allow write: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
    }

    match /protected/stakes/{stakeId}/activities/{activityId}/parent-ids/{registrationId}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
      allow write: if isStakeAdmin(stakeId) || isRegistrationOwner(stakeId, activityId, registrationId);
    }

    // PDF di audit dell'autorizzazione genitoriale: scritti solo da Cloud Functions
    // (Admin SDK bypassa queste rules), letti solo da admin di stake.
    // L'utente / genitore non deve poter leggere il PDF dal browser.
    match /protected/stakes/{stakeId}/activities/{activityId}/parent-authorization-pdfs/{registrationId}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId);
      allow write: if false;
    }

    // Firme genitore raccolte tramite magic-link (separate da quelle MVP esistenti
    // per evitare collisioni con consenti già caricati dall'utente loggato).
    match /protected/stakes/{stakeId}/activities/{activityId}/parent-authorization-signatures/{registrationId}/{fileName=**} {
      allow read: if isStakeAdmin(stakeId);
      allow write: if false;
    }

    // Galleria foto/video dell'attività (docs/GALLERIA_ATTIVITA.md): la vede
    // e la riempie solo un membro attivo del palo o lo staff, mai una sessione anonima.
    // Ognuno crea solo file nuovi marcati col proprio uid (niente sovrascritture
    // di file altrui) e cancella solo i propri; lo staff (admin, dirigenti di
    // unità) cancella tutto. Tetti: foto 30 MB, video 300 MB, come nel client.
    function isNonAnonymousSignedIn() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function memberDocPath(stakeId) {
      return /databases/(default)/documents/stakes/$(stakeId)/members/$(request.auth.uid);
    }

    function isActiveStakeMember(stakeId) {
      return isNonAnonymousSignedIn()
        && firestore.exists(memberDocPath(stakeId))
        && firestore.get(memberDocPath(stakeId)).data.status == 'active';
    }

    // Un membro attivo usa solo members, anche per i poteri dello staff.
    // Il profilo resta un fallback per lo staff senza appartenenza attiva:
    // così ogni richiesta legge al massimo members + users oppure members + media.
    function isGalleryAdmin(stakeId) {
      return isNonAnonymousSignedIn()
        && (isActiveStakeMember(stakeId)
          ? isAdminRole(firestore.get(memberDocPath(stakeId)).data.get('staffRole', null))
          : isStakeAdmin(stakeId));
    }

    function isGalleryStaff(stakeId) {
      return isNonAnonymousSignedIn()
        && (isActiveStakeMember(stakeId)
          ? firestore.get(memberDocPath(stakeId)).data.get('staffRole', null) in ['admin', 'super_admin', 'unit_leader']
          : (isStakeAdmin(stakeId)
            || (currentUserExists() && currentUser().role == 'unit_leader' && currentUser().stakeId == stakeId)));
    }

    function isStakeMember(stakeId) {
      return isActiveStakeMember(stakeId) || isGalleryStaff(stakeId);
    }

    function validGalleryUpload() {
      return request.resource.metadata != null
        && request.resource.metadata.uploadedBy == request.auth.uid
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 30 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 300 * 1024 * 1024)
        );
    }

    // Un contenuto nascosto da una segnalazione non ha più il doc in `media`:
    // i suoi file li legge solo lo staff (la callable ne rigenera anche i token
    // degli URL, così i link già visti smettono di funzionare).
    match /protected/stakes/{stakeId}/galleries/{galleryId}/media/{mediaId}/{fileName=**} {
      // get: anche l'autore dei propri file, che chiede l'URL prima che il doc
      // media esista. list: i nomi dei file senza token, serve per ripulire la
      // cartella di un caricamento annullato.
      allow get: if isGalleryStaff(stakeId)
        || (isStakeMember(stakeId)
          && (
            (resource.metadata != null && resource.metadata.uploadedBy == request.auth.uid)
            || firestore.exists(/databases/(default)/documents/stakes/$(stakeId)/galleries/$(galleryId)/media/$(mediaId))
          ));
      allow list: if isStakeMember(stakeId);
      // resource == null: solo file nuovi. Un upload su un path esistente può
      // arrivare come create (l'emulatore lo fa): senza, si sovrascrive il
      // file di un altro.
      // Writes require active membership even for staff: member + lifecycle =
      // two cross-service documents, the production Storage Rules limit.
      allow create: if isActiveStakeMember(stakeId)
        && !firestore.exists(/databases/(default)/documents/stakes/$(stakeId)/galleries/$(galleryId)/mediaLifecycle/$(mediaId))
        && (isAdminRole(firestore.get(memberDocPath(stakeId)).data.get('staffRole', null))
          || (resource == null && validGalleryUpload()));
      allow update: if isActiveStakeMember(stakeId)
        && isAdminRole(firestore.get(memberDocPath(stakeId)).data.get('staffRole', null))
        && !firestore.exists(/databases/(default)/documents/stakes/$(stakeId)/galleries/$(galleryId)/mediaLifecycle/$(mediaId));
      allow delete: if isGalleryStaff(stakeId)
        || (isStakeMember(stakeId) && resource.metadata != null && resource.metadata.uploadedBy == request.auth.uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
